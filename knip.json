{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "src/router.tsx",
    "src/server.ts",
    "src/routes/**/*.tsx",
    "src/**/*.test.{ts,tsx}",
    "vite.config.ts",
    "scripts/seoPrerender.ts"
  ],
  "project": [
